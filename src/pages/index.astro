---
import { client } from "../lib/sanity";
import { homepageQuery, headerQuery } from "../lib/queries";

import Header from "../components/layout/Header.astro";
import Hero from "../components/home/Hero.astro";
import Statistics from "../components/home/Statistics.astro";
import Solutions from "../components/home/Solutions.astro";
import Process from "../components/home/Process.astro";
import SuccessStories from "../components/home/SuccessStories.astro";
import TrustBrands from "../components/home/TrustBrands.astro";
import Testimonials from "../components/home/Testimonials.astro";
import WhoWeWorkWith from "../components/home/WhoWeWorkWith.astro";
import Faq from "../components/home/Faq.astro";
import Footer from "../components/layout/Footer.astro";

import "../styles/global.css";

const homepage = await client.fetch(homepageQuery);
const header = await client.fetch(headerQuery);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>RightDirect | AI Powered Digital Transformation</title>

    <meta
      name="description"
      content="Accelerate go-to-market, elevate customer experiences and enable modern workplaces with AI-powered agile delivery solutions."
    />
  </head>

  <body>
    <Header header={header} />
    <Hero hero={homepage.hero} />
    <Statistics statistics={homepage.statistics} />
    <Solutions solutions={homepage.solutions} />
    <Process process={homepage.process} />
    <SuccessStories successStories={homepage.successStories} />
    <TrustBrands trustedBrands={homepage.trustedBrands} />
    <Testimonials testimonial={homepage.testimonial} />
    <WhoWeWorkWith whoWeWorkWith={homepage.whoWeWorkWith} />
    <Faq faq={homepage.faq} />
    <Footer footer={homepage.footer} />
  </body>
</html>