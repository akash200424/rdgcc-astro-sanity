---
import { urlFor } from "../../lib/sanity";

const { footer } = Astro.props;
---

<section class="relative">

  <!-- CTA Banner -->
  <div class="relative h-[430px] overflow-hidden">

    {
      footer.backgroundImage && (
        <img
          src={urlFor(footer.backgroundImage).url()}
          alt=""
          class="absolute inset-0 h-full w-full object-cover"
        />
      )
    }

    <!-- Overlay -->
    <div class="absolute inset-0 bg-black/60"></div>

    <!-- CTA Content -->
    <div class="relative z-10 mx-auto flex h-full max-w-[1800px] flex-col items-center justify-center px-12 text-center">

      <h2 class="max-w-5xl text-[64px] font-bold leading-tight text-white">
        {footer.heading}
      </h2>

      <p class="mt-6 max-w-4xl text-[24px] leading-10 text-white/90">
        {footer.description}
      </p>

      {
        footer.button && (
          <a
            href={footer.button.url}
            class="mt-10 inline-flex items-center gap-3 rounded-full bg-[#0A4D8C] px-10 py-4 text-[18px] font-semibold text-white transition hover:bg-[#08376E]"
          >
            {footer.button.text}

            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12h14M13 5l7 7-7 7"
              />
            </svg>

          </a>
        )
      }

    </div>

  </div>

  <!-- Footer -->
  <footer class="bg-[#081C3A] text-white">

    <div class="mx-auto max-w-[1800px] px-12 py-20">

      <!-- Logo -->
      <div class="text-center">

        {
          footer.logo && (
            <img
              src={urlFor(footer.logo).url()}
              alt={footer.companyName}
              class="mx-auto h-16 object-contain"
            />
          )
        }

        <h3 class="mt-6 text-[34px] font-semibold">
          {footer.companyName}
        </h3>

      </div>

      <!-- Addresses -->
      <div class="mt-16 grid gap-12 md:grid-cols-2">

        {
          footer.addresses?.map((office: any) => (

            <div>

              <h4 class="mb-5 text-[28px] font-semibold">
                {office.title}
              </h4>

              <p class="whitespace-pre-line text-[20px] leading-9 text-gray-300">
                {office.address}
              </p>

            </div>

          ))
        }

      </div>

      <!-- About -->
      <div class="mx-auto mt-16 max-w-6xl text-center">

        <p class="text-[20px] leading-9 text-gray-300">
          {footer.about}
        </p>

      </div>

      <!-- Footer Links -->
      <div class="mt-14 flex flex-wrap justify-center gap-10 text-[18px]">

        {
          footer.links?.map((link: any) => (

            <a
              href={link.url}
              class="transition text-gray-300 hover:text-white"
            >
              {link.text}
            </a>

          ))
        }

      </div>

      <!-- Copyright -->
      <div class="mt-12 border-t border-white/10 pt-8 text-center text-[16px] text-gray-400">
        {footer.copyright}
      </div>

    </div>

  </footer>

</section>