---
import { urlFor } from "../../lib/sanity";

const { header } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-[#FCFCFA]/95 backdrop-blur-md">

  <div class="mx-auto flex h-16 md:h-18 lg:h-20 max-w-[1280px] items-center justify-between px-5 md:px-8">

    <!-- Logo -->
    <a href="/" class="flex items-center">
      {
        header.logo && (
          <img
            src={urlFor(header.logo).url()}
            alt="Logo"
            class="h-10 md:h-12 lg:h-14 w-auto object-contain transition duration-300 hover:scale-105"
          />
        )
      }
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-8 lg:flex">

      {
        header.navigation?.map((item: any) => (
          <a
            href={item.url}
            class="relative text-[15px] font-medium tracking-wide text-slate-700 transition duration-300 hover:text-[#0A4D8C] after:absolute after:-bottom-2 after:left-0 after:h-[2px] after:w-0 after:bg-[#0A4D8C] after:transition-all hover:after:w-full"
          >
            {item.label}
          </a>
        ))
      }

      <!-- About -->
      <div class="group relative">

        <button
          class="flex items-center gap-2 text-[15px] font-medium tracking-wide text-slate-700 transition duration-300 hover:text-[#0A4D8C]"
        >
          About

          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 transition group-hover:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            />
          </svg>

        </button>

        <div
          class="invisible absolute left-0 top-full mt-4 w-56 rounded-xl border border-slate-200 bg-white py-2 opacity-0 shadow-lg transition-all duration-300 group-hover:visible group-hover:opacity-100"
        >

          {
            header.aboutMenu?.map((item: any) => (
              <a
                href={item.url}
                class="block px-5 py-3 text-[14px] font-medium text-slate-700 transition hover:bg-slate-50 hover:text-[#0A4D8C]"
              >
                {item.label}
              </a>
            ))
          }

        </div>

      </div>

    </nav>

    <!-- CTA -->
    {
      header.ctaButton && (
        <a
          href={header.ctaButton.url}
          class="hidden lg:inline-flex rounded-full bg-[#0A4D8C] px-6 py-2.5 text-[14px] font-semibold text-white shadow-md transition hover:bg-[#08376E]"
        >
          {header.ctaButton.text}
        </a>
      )
    }

    <!-- Mobile Button -->
    <button
      id="mobile-menu-button"
      class="rounded-lg p-2 transition hover:bg-slate-100 lg:hidden"
      aria-label="Toggle Menu"
    >

      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-7 w-7 text-slate-700"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>

    </button>

  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-slate-200 bg-[#FCFCFA] lg:hidden"
  >

    <nav class="flex flex-col py-4">

      {
        header.navigation?.map((item: any) => (
          <a
            href={item.url}
            class="mobile-link px-6 py-3 text-[16px] font-medium text-slate-700 transition hover:bg-slate-100 hover:text-[#0A4D8C]"
          >
            {item.label}
          </a>
        ))
      }

      <div class="px-6 pt-4 pb-2 text-xs font-semibold uppercase tracking-widest text-slate-400">
        About
      </div>

      {
        header.aboutMenu?.map((item: any) => (
          <a
            href={item.url}
            class="mobile-link px-10 py-3 text-[15px] text-slate-700 transition hover:bg-slate-100 hover:text-[#0A4D8C]"
          >
            {item.label}
          </a>
        ))
      }

      {
        header.ctaButton && (
          <a
            href={header.ctaButton.url}
            class="mobile-link mx-6 mt-5 rounded-full bg-[#0A4D8C] px-6 py-3 text-center text-[15px] font-semibold text-white"
          >
            {header.ctaButton.text}
          </a>
        )
      }

    </nav>

  </div>

</header>

<script is:inline>
  function initMobileMenu() {
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");

    if (!button || !menu) return;

    const newButton = button.cloneNode(true);
    button.parentNode.replaceChild(newButton, button);

    newButton.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });

    menu.querySelectorAll(".mobile-link").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initMobileMenu);
  document.addEventListener("astro:page-load", initMobileMenu);
</script>