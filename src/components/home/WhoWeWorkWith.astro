---
import { urlFor } from "../../lib/sanity";

const { whoWeWorkWith } = Astro.props;
---

<section
  id="who-we-work-with"
  class="bg-white py-20"
>
  <div class="mx-auto max-w-[1300px] px-8">

    <!-- Heading -->
    <div class="mx-auto max-w-[900px] text-center">

      <h2
        class="text-[40px] font-bold leading-tight tracking-[-0.5px] text-[#0A4D8C]"
      >
        {whoWeWorkWith.heading}
      </h2>

      <p
        class="mx-auto mt-5 max-w-[760px] text-[16px] leading-7 text-slate-600"
      >
        {whoWeWorkWith.description}
      </p>

    </div>

    <!-- Categories -->
    <div class="mt-16 space-y-20">

      {
        whoWeWorkWith?.categories?.map((item: any, index: number) => (

          <div
            class={`grid items-center gap-14 ${
              index % 2 === 0
                ? "lg:grid-cols-[320px_1fr]"
                : "lg:grid-cols-[1fr_320px]"
            }`}
          >

            {
              index % 2 === 0 ? (

                <div class="flex justify-center">

                  {
                    item.image && (
                      <img
                        src={urlFor(item.image).url()}
                        alt={item.title}
                        class="h-[280px] w-[280px] rounded-full object-cover shadow-xl"
                      />
                    )
                  }

                </div>

              ) : (

                <div class="max-w-[760px]">

                  <h3
                    class="text-[28px] font-bold leading-tight text-[#0A4D8C]"
                  >
                    {item.title}
                  </h3>

                  <p
                    class="mt-5 text-[16px] leading-7 text-slate-600"
                  >
                    {item.description}
                  </p>

                </div>

              )
            }

            {
              index % 2 === 0 ? (

                <div class="max-w-[760px]">

                  <h3
                    class="text-[28px] font-bold leading-tight text-[#0A4D8C]"
                  >
                    {item.title}
                  </h3>

                  <p
                    class="mt-5 text-[16px] leading-7 text-slate-600"
                  >
                    {item.description}
                  </p>

                </div>

              ) : (

                <div class="flex justify-center">

                  {
                    item.image && (
                      <img
                        src={urlFor(item.image).url()}
                        alt={item.title}
                        class="h-[280px] w-[280px] rounded-full object-cover shadow-xl"
                      />
                    )
                  }

                </div>

              )
            }

          </div>

        ))
      }

    </div>

  </div>
</section>
```