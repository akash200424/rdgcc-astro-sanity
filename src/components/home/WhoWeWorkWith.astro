---
import { urlFor } from "../../lib/sanity";

const { whoWeWorkWith } = Astro.props;
---

<section class="py-20 bg-gray-50">
  <div class="mx-auto max-w-7xl px-6">
    <h2 class="text-center text-4xl font-bold">
      {whoWeWorkWith.heading}
    </h2>

    <p class="mt-4 text-center text-gray-600">
      {whoWeWorkWith.description}
    </p>

    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        whoWeWorkWith?.categories?.map((item: any) => (
          <div class="rounded-xl border p-6 text-center shadow-sm">
            {
              item.image && (
                <img
                  src={urlFor(item.image).url()}
                  alt={item.title}
                  class="mx-auto mb-4 h-20 w-20 object-contain"
                />
              )
            }

            <h3 class="text-xl font-semibold">
              {item.title}
            </h3>

            <p class="mt-2 text-gray-600">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>