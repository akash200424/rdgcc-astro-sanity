---
import { urlFor } from "../../lib/sanity";

const { trustedBrands } = Astro.props;
---

<section class="py-20 bg-gray-50">
  <div class="mx-auto max-w-7xl px-6">
    <h2 class="text-center text-4xl font-bold">
      {trustedBrands.heading}
    </h2>

    <div class="mt-12 grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-6">
      {
        trustedBrands?.brands?.map((brand: any) => (
          <div class="flex items-center justify-center rounded-lg border p-6">
            <img
              src={urlFor(brand.logo).url()}
              alt="Brand Logo"
              class="max-h-16 object-contain"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>