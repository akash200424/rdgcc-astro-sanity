---
const { footer } = Astro.props;
---

<footer class="bg-gray-900 text-white py-16">
  <div class="mx-auto max-w-7xl px-6">

    <div class="mb-12 text-center">
      <h2 class="text-4xl font-bold">
        {footer.ctaHeading}
      </h2>

      <p class="mt-4 text-gray-300">
        {footer.ctaDescription}
      </p>

      {
        footer.button && (
          <a
            href={footer.button.url}
            class="mt-8 inline-block rounded-lg bg-blue-600 px-6 py-3"
          >
            {footer.button.text}
          </a>
        )
      }
    </div>

    <div class="grid gap-10 md:grid-cols-3">

      <div>
        <h3 class="font-semibold mb-3">
          Delivery Office
        </h3>

        <p>{footer.deliveryOffice}</p>
      </div>

      <div>
        <h3 class="font-semibold mb-3">
          Registered Office
        </h3>

        <p>{footer.registeredOffice}</p>
      </div>

      <div>
        <h3 class="font-semibold mb-3">
          About
        </h3>

        <p>{footer.aboutCompany}</p>
      </div>

    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-gray-700 pt-6 md:flex-row md:justify-between">

      <p>{footer.copyright}</p>

      <div class="space-x-6">
        <a href={footer.privacyPolicyUrl}>
          Privacy Policy
        </a>

        <a href={footer.termsConditionsUrl}>
          Terms & Conditions
        </a>
      </div>

    </div>

  </div>
</footer>