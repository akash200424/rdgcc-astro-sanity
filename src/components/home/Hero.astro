---
const { hero } = Astro.props;
---

<section
  id="hero"
  class="overflow-hidden bg-[#FAFBFC]"
>
  <div
    class="mx-auto grid min-h-[760px] max-w-[1900px] items-center gap-16 px-20 py-8 lg:grid-cols-[65%_35%]"
  >

    <!-- Left Content -->
    <div class="max-w-[1100px]">

      <h1
        class="space-y-2 text-[72px] font-bold leading-[1.05] tracking-[-2px]"
      >

        {
          hero?.headingLines?.map((line: any) => (

            <div>

              <span class="text-[#111827]">
                {line.normalText}
              </span>

              {
                line.highlightText && (
                  <span class="ml-3 text-[#0A4D8C]">
                    {line.highlightText}
                  </span>
                )
              }

            </div>

          ))
        }

      </h1>

      <p
        class="mt-10 max-w-[900px] text-[24px] leading-[1.8] text-slate-600"
      >
        {hero.description}
      </p>

      {
        hero?.button && (

          <a
            href={hero.button.url}
            class="mt-12 inline-flex items-center gap-3 rounded-full bg-[#0A4D8C] px-10 py-5 text-[20px] font-semibold text-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:bg-[#08376E] hover:shadow-2xl"
          >

            {hero.button.text}

            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 12h14M13 5l7 7-7 7"
              />
            </svg>

          </a>

        )
      }

    </div>

    <!-- Right Illustration -->
    <div class="hidden lg:flex items-center justify-center">

      <div class="relative h-[700px] w-[700px]">

        <!-- Background Block -->
        <div
          class="absolute left-24 top-24 h-[470px] w-[470px] rounded-[42px] bg-[#EAF2FB]"
        ></div>

        <!-- Outline Square -->
        <div
          class="absolute left-40 top-40 h-[360px] w-[360px] rounded-[36px] border-[14px] border-[#DCE9F8]"
        ></div>

        <!-- Top Grey -->
        <div
          class="absolute right-10 top-0 h-44 w-44 rounded-[30px] bg-[#C7C7C7] shadow-2xl"
        ></div>

        <!-- Bottom Blue -->
        <div
          class="absolute bottom-10 left-0 h-56 w-56 rounded-[34px] bg-[#4D7FAF] shadow-2xl"
        ></div>

        <!-- Small Blue -->
        <div
          class="absolute bottom-0 left-60 h-16 w-16 rounded-2xl bg-[#4D7FAF] shadow-xl"
        ></div>

        <!-- Small Grey -->
        <div
          class="absolute right-28 top-48 h-16 w-16 rounded-2xl bg-[#BDBDBD] shadow-lg"
        ></div>

      </div>

    </div>

  </div>
</section>