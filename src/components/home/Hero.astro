---
import { urlFor } from "../../lib/sanity";

const { hero } = Astro.props;
---

<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <h1 class="text-5xl font-bold leading-tight">
        {hero.heading}
      </h1>

      <p class="mt-6 text-lg text-gray-600">
        {hero.description}
      </p>

      <a
        href={hero.button.url}
        class="mt-8 inline-block rounded-lg bg-blue-600 px-6 py-3 text-white hover:bg-blue-700"
      >
        {hero.button.text}
      </a>
    </div>

    <div>
      {
        hero.image && (
          <img
            src={urlFor(hero.image).url()}
            alt={hero.heading}
            class="w-full rounded-xl"
          />
        )
      }
    </div>
  </div>
</section>