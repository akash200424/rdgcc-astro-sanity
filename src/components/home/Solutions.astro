---
import { urlFor } from "../../lib/sanity";

const { solutions } = Astro.props;
---

<section id="solutions" class="bg-white py-20">
  <div class="mx-auto max-w-[1280px] px-8">

    <!-- Heading -->
    <div class="mx-auto max-w-4xl text-center">

      <h2
        class="text-[40px] font-bold leading-tight tracking-tight text-[#0A4D8C]"
      >
        {solutions.heading}
      </h2>

      <p
        class="mx-auto mt-5 max-w-3xl text-[16px] leading-7 text-slate-600"
      >
        {solutions.description}
      </p>

    </div>

    <!-- Cards -->
    <div class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-4">

      {
        solutions.items?.map((item: any) => (

          <article
            class="flex min-h-[620px] flex-col overflow-hidden rounded-[20px] bg-white shadow-md transition-all duration-300 hover:-translate-y-2 hover:shadow-xl"
          >

            <!-- Image -->
            {
              item.icon && (
                <img
                  src={urlFor(item.icon)
                        .width(700)
                        .height(450)
                        .fit("crop")
                        .auto("format")
                        .quality(80)
                        .url()}
                  alt={item.title}
                  class="h-[170px] w-full object-cover"
                />
              )
            }

            <!-- Content -->
            <div class="flex flex-1 flex-col p-6">

              <!-- Title -->
              <h3
                class="text-[22px] font-bold leading-tight text-[#0A4D8C]"
              >
                {item.title}
              </h3>

              <!-- Description -->
              <p
                class="mt-4 text-[15px] leading-6 text-slate-600"
              >
                {item.description}
              </p>

              <!-- Bullet Points -->
              {
                item.bulletPoints &&
                item.bulletPoints.length > 0 && (

                  <ul class="mt-5 flex-1 list-disc space-y-2 pl-5 text-[14px] leading-6 text-slate-700">

                    {
                      item.bulletPoints.map((point: string) => (
                        <li>{point}</li>
                      ))
                    }

                  </ul>

                )
              }

              <!-- Button -->
              <div class="mt-auto pt-6">

                {
                  item.button && (
                    <a
                      href={item.button.url}
                      class="inline-flex w-fit items-center gap-2 rounded-full bg-[#0A4D8C] px-5 py-2.5 text-[14px] font-semibold text-white transition duration-300 hover:bg-[#08376E]"
                    >
                      {item.button.text}

                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 12h14M13 5l7 7-7 7"
                        />
                      </svg>

                    </a>
                  )
                }

              </div>

            </div>

          </article>

        ))
      }

    </div>

  </div>
</section>
```