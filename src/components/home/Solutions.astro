---
import { urlFor } from "../../lib/sanity";

const { solutions } = Astro.props;
---

<section id="solutions" class="bg-white py-32">
  <div class="mx-auto max-w-[1750px] px-12">

    <!-- Heading -->
    <div class="mx-auto max-w-6xl text-center">

      <h2
        class="text-[64px] font-bold leading-tight tracking-tight text-[#0A4D8C]"
      >
        {solutions.heading}
      </h2>

      <p
        class="mx-auto mt-8 max-w-5xl text-[24px] leading-10 text-slate-600"
      >
        {solutions.description}
      </p>

    </div>

    <!-- Cards -->
    <div class="mt-24 grid gap-8 md:grid-cols-2 xl:grid-cols-4">

      {
        solutions.items?.map((item: any) => (

          <article
            class="flex min-h-[860px] flex-col overflow-hidden rounded-[28px] bg-white shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl"
          >

            <!-- Image -->
            {
              item.icon && (
                <img
                  src={urlFor(item.icon).url()}
                  alt={item.title}
                  class="h-[260px] w-full object-cover"
                />
              )
            }

            <!-- Content -->
            <div class="flex flex-1 flex-col p-10">

              <!-- Title -->
              <h3
                class="text-[36px] font-bold leading-tight text-[#0A4D8C]"
              >
                {item.title}
              </h3>

              <!-- Description -->
              <p
                class="mt-6 text-[20px] leading-9 text-slate-600"
              >
                {item.description}
              </p>

              <!-- Bullet Points -->
              {
  item.bulletPoints &&
  item.bulletPoints.length > 0 && (

    <ul class="mt-8 flex-1 list-disc space-y-4 pl-7 text-[18px] leading-9 text-slate-700">

      {
        item.bulletPoints.map((point: string) => (
          <li>{point}</li>
        ))
      }

    </ul>

  )
}

              <!-- Button -->
              <div class="mt-auto pt-10">

                {
                  item.button && (
                    <a
                      href={item.button.url}
                      class="inline-flex w-fit items-center gap-3 rounded-full bg-[#0A4D8C] px-8 py-4 text-[18px] font-semibold text-white transition duration-300 hover:bg-[#08376E]"
                    >
                      {item.button.text}

                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 12h14M13 5l7 7-7 7"
                        />
                      </svg>

                    </a>
                  )
                }

              </div>

            </div>

          </article>

        ))
      }

    </div>

  </div>
</section>