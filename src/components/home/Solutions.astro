---
import { urlFor } from "../../lib/sanity";

const { solutions } = Astro.props;
---

<section id="solutions" class="bg-white py-28">
  <div class="mx-auto max-w-[1700px] px-16">

    <!-- Heading -->
    <div class="mx-auto max-w-6xl text-center">
      <h2 class="text-[64px] font-bold leading-tight tracking-[-1px] text-[#0A4D8C]">
        {solutions.heading}
      </h2>

      <p class="mx-auto mt-8 max-w-5xl text-[24px] leading-10 text-slate-600">
        {solutions.description}
      </p>
    </div>

    <!-- Cards -->
    <div class="mt-20 grid gap-8 md:grid-cols-2 xl:grid-cols-4">

      {
        solutions.items?.map((item: any) => (
          <div
            class="overflow-hidden rounded-[24px] bg-white shadow-md transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl"
          >

            <!-- Image -->
            {
              item.icon && (
                <img
                  src={urlFor(item.icon).url()}
                  alt={item.title}
                  class="h-[240px] w-full object-cover"
                />
              )
            }

            <!-- Content -->
            <div class="p-8">

              <h3 class="text-[22px] font-bold leading-tight text-[#0A4D8C]">
                {item.title}
              </h3>

              <p class="mt-5 text-[18px] leading-8 text-slate-600">
                {item.description}
              </p>

              {
                item.button && (
                  <a
                    href={item.button.url}
                    class="mt-8 inline-flex items-center gap-2 rounded-full bg-[#0A4D8C] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#08376E]"
                  >
                    {item.button.text}

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 12h14M13 5l7 7-7 7"
                      />
                    </svg>
                  </a>
                )
              }

            </div>

          </div>
        ))
      }

    </div>

  </div>
</section>