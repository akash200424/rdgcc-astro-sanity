---
import { urlFor } from "../../lib/sanity";

const { testimonial } = Astro.props;
---

<section id="testimonials" class="bg-[#FFFDF8] py-20">

  <div class="mx-auto max-w-[1350px] px-8">

    <!-- Heading -->
    <div class="mx-auto max-w-[900px] text-center">

      <h2
        class="text-[40px] font-bold leading-tight text-[#0A4D8C]"
      >
        {testimonial.heading}
      </h2>

      {
        testimonial.description && (
          <p
            class="mx-auto mt-5 max-w-[760px] text-[16px] leading-7 text-slate-600"
          >
            {testimonial.description}
          </p>
        )
      }

    </div>

    <!-- Carousel -->
    <div class="relative mt-16 overflow-hidden">

      <div
        id="testimonial-track"
        class="flex transition-transform duration-700 ease-in-out"
      >

        {
          testimonial?.testimonials?.map((item: any) => (

            <div class="w-full flex-shrink-0 px-4">

              <div
                class="mx-auto max-w-[1100px] rounded-[24px] bg-[#F8F2E9] p-10 shadow-lg"
              >

                <div
                  class="grid items-center gap-10 lg:grid-cols-[180px_1fr]"
                >

                  <!-- Client -->
                  <div class="flex flex-col items-center text-center">

                    {
                      item.clientImage && (
                        <img
                          src={urlFor(item.clientImage).url()}
                          alt={item.clientName}
                          class="h-28 w-28 rounded-full border-4 border-white object-cover shadow-lg"
                        />
                      )
                    }

                    <h3
                      class="mt-5 text-[22px] font-bold text-[#0A4D8C]"
                    >
                      {item.clientName}
                    </h3>

                    <p
                      class="mt-1 text-[15px] text-slate-600"
                    >
                      {item.designation}
                    </p>

                    {
                      item.company && (
                        <p
                          class="mt-1 text-[15px] font-semibold text-[#0A4D8C]"
                        >
                          {item.company}
                        </p>
                      )
                    }

                    {
                      item.companyLocation && (
                        <p
                          class="mt-2 text-[12px] uppercase tracking-[1.5px] text-slate-500"
                        >
                          {item.companyLocation}
                        </p>
                      )
                    }

                  </div>

                  <!-- Quote -->
                  <div>

                    <div
                      class="text-[72px] font-serif leading-none text-[#D6B48A]"
                    >
                      "
                    </div>

                    <p
                      class="-mt-3 text-[18px] italic leading-8 text-slate-700"
                    >
                      {item.quote}
                    </p>

                  </div>

                </div>

              </div>

            </div>

          ))
        }

      </div>

    </div>

    <!-- Navigation Dots -->
    <div
      id="testimonial-dots"
      class="mt-10 flex justify-center gap-3"
    >

      {
        testimonial?.testimonials?.map((_: any, i: number) => (

          <button
            class="testimonial-dot h-2.5 w-2.5 rounded-full bg-[#D6B48A] transition-all duration-300"
            data-index={i}
            aria-label={`Go to testimonial ${i + 1}`}
          />

        ))
      }

    </div>

  </div>

</section>

<script>
  function initTestimonialCarousel() {
    const track = document.getElementById("testimonial-track");
    const dots = document.querySelectorAll(".testimonial-dot");

    if (!track || dots.length === 0) return;

    let current = 0;
    const total = dots.length;
    let autoplay;

    function goTo(index) {
      current = (index + total) % total;

      track.style.transform = `translateX(-${current * 100}%)`;

      dots.forEach((dot, i) => {
        if (i === current) {
          dot.classList.remove("w-2.5", "bg-[#D6B48A]");
          dot.classList.add("w-8", "bg-[#0A4D8C]");
        } else {
          dot.classList.remove("w-8", "bg-[#0A4D8C]");
          dot.classList.add("w-2.5", "bg-[#D6B48A]");
        }
      });
    }

    function startAutoplay() {
      autoplay = setInterval(() => {
        goTo(current + 1);
      }, 5000);
    }

    function resetAutoplay() {
      clearInterval(autoplay);
      startAutoplay();
    }

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        goTo(i);
        resetAutoplay();
      });
    });

    goTo(0);
    startAutoplay();
  }

  document.addEventListener("astro:page-load", initTestimonialCarousel);
  initTestimonialCarousel();
</script>
```