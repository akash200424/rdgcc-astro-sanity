---
const { faq } = Astro.props;
---

<section id="faq" class="bg-[#F8F9FB] py-20">
  <div class="mx-auto max-w-[1300px] px-8">

    <!-- Heading -->
    <div class="mx-auto max-w-[850px] text-center">

      <h2
        class="text-[40px] font-bold leading-tight tracking-[-0.5px] text-[#0A4D8C]"
      >
        {faq.heading}
      </h2>

      {
        faq.description && (
          <p
            class="mx-auto mt-5 max-w-[700px] text-[16px] leading-7 text-slate-600"
          >
            {faq.description}
          </p>
        )
      }

    </div>

    <!-- FAQ List -->
    <div class="mx-auto mt-14 max-w-[1050px]">

      {
        faq.items?.map((item: any) => (

          <details class="group border-b border-slate-300 py-7">

            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-8"
            >

              <span
                class="pr-6 text-[22px] font-semibold leading-8 text-slate-900"
              >
                {item.title}
              </span>

              <!-- Chevron -->
              <div
                class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full border border-slate-300 transition-transform duration-300 group-open:rotate-90"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-[#0A4D8C]"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </div>

            </summary>

            <!-- Content -->
            <div class="mt-7 max-w-[950px]">

              <h3
                class="text-[20px] font-semibold leading-tight text-[#0A4D8C]"
              >
                {item.question}
              </h3>

              <p
                class="mt-4 text-[15px] leading-7 text-slate-600"
              >
                {item.answer}
              </p>

              {
                item.linkText &&
                item.linkUrl && (

                  <a
                    href={item.linkUrl}
                    class="mt-6 inline-flex items-center gap-2 text-[15px] font-semibold text-[#0A4D8C] transition hover:underline"
                  >
                    {item.linkText}

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M5 12h14M13 5l7 7-7 7"
                      />
                    </svg>

                  </a>

                )
              }

            </div>

          </details>

        ))
      }

    </div>

    <!-- Button -->
    {
      faq.button && (

        <div class="mt-14 text-center">

          <a
            href={faq.button.url}
            class="inline-flex items-center rounded-full bg-[#0A4D8C] px-8 py-3 text-[15px] font-semibold text-white shadow-lg transition hover:bg-[#08376E]"
          >
            {faq.button.text}
          </a>

        </div>

      )
    }

  </div>
</section>
```