---
const { faq } = Astro.props;
---

<section id="faq" class="bg-white py-20">
  <div class="mx-auto max-w-6xl px-6">

    <h2 class="text-center text-5xl font-bold text-blue-900">
      {faq.heading}
    </h2>

    {
      faq.description && (
        <p class="mx-auto mt-4 max-w-3xl text-center text-gray-600">
          {faq.description}
        </p>
      )
    }

    <div class="mt-12 space-y-6">

      {
        faq.items?.map((item: any) => (

          <details class="group border-b pb-6">

            <summary class="flex cursor-pointer list-none items-center justify-between text-2xl">

              <span>
                {item.title}
              </span>

              <span class="text-3xl transition group-open:rotate-90">
                ›
              </span>

            </summary>

            <div class="mt-8">

              <h3 class="text-2xl font-semibold">
                Q: {item.question}
              </h3>

              <p class="mt-5 leading-8 text-gray-700">
                {item.answer}
              </p>

              {
                item.linkText && item.linkUrl && (

                  <a
                    href={item.linkUrl}
                    class="mt-6 inline-block text-lg font-medium text-blue-700 hover:underline"
                  >
                    {item.linkText} →
                  </a>

                )
              }

            </div>

          </details>

        ))
      }

    </div>

    {
      faq.button && (

        <div class="mt-12 text-center">

          <a
            href={faq.button.url}
            class="rounded-full bg-blue-800 px-8 py-4 text-white"
          >
            {faq.button.text}
          </a>

        </div>

      )
    }

  </div>
</section>