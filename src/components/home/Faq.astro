---
const { faq } = Astro.props;
---

<section id="faq" class="bg-[#F8F9FB] py-32">
  <div class="mx-auto max-w-[1850px] px-16">

    <!-- Heading -->
    <div class="mx-auto max-w-[1500px] text-center">

      <h2
        class="text-[64px] font-bold leading-tight tracking-[-1px] text-[#0A4D8C]"
      >
        {faq.heading}
      </h2>

      {
        faq.description && (
          <p
            class="mx-auto mt-8 max-w-[1200px] text-[24px] leading-[1.8] text-slate-600"
          >
            {faq.description}
          </p>
        )
      }

    </div>

    <!-- FAQ List -->
    <div class="mx-auto mt-24 max-w-[1600px]">

      {
        faq.items?.map((item: any) => (

          <details class="group border-b border-slate-300 py-10">

            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-12"
            >

              <span
                class="pr-10 text-[34px] font-semibold leading-[1.5] text-slate-900"
              >
                {item.title}
              </span>

              <!-- Chevron -->
              <div
                class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full border border-slate-300 transition-transform duration-300 group-open:rotate-90"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6 text-[#0A4D8C]"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </div>

            </summary>

            <!-- Content -->
            <div class="mt-10 max-w-[1450px] pl-2">

              <h3
                class="text-[30px] font-semibold leading-tight text-[#0A4D8C]"
              >
                {item.question}
              </h3>

              <p
                class="mt-6 text-[22px] leading-[1.9] text-slate-600"
              >
                {item.answer}
              </p>

              {
                item.linkText &&
                item.linkUrl && (

                  <a
                    href={item.linkUrl}
                    class="mt-8 inline-flex items-center gap-3 text-[20px] font-semibold text-[#0A4D8C] transition hover:underline"
                  >
                    {item.linkText}

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M5 12h14M13 5l7 7-7 7"
                      />
                    </svg>

                  </a>

                )
              }

            </div>

          </details>

        ))
      }

    </div>

    <!-- Button -->
    {
      faq.button && (

        <div class="mt-20 text-center">

          <a
            href={faq.button.url}
            class="inline-flex items-center rounded-full bg-[#0A4D8C] px-12 py-5 text-[20px] font-semibold text-white shadow-lg transition hover:bg-[#08376E]"
          >
            {faq.button.text}
          </a>

        </div>

      )
    }

  </div>
</section>