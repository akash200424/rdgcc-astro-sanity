---
import { urlFor } from "../../lib/sanity";

const { process } = Astro.props;
---

<section id="process" class="bg-gray-50 py-20">
  <div class="mx-auto max-w-7xl px-6">
    <h2 class="text-center text-4xl font-bold text-blue-900">
      {process.heading}
    </h2>

    <p class="mx-auto mt-4 max-w-4xl text-center text-gray-600">
      {process.description}
    </p>

    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        process?.steps?.map((step: any) => (
          <div class="rounded-2xl bg-white p-8 shadow-md transition hover:-translate-y-2 hover:shadow-xl">

            {
              step.icon && (
                <img
                  src={urlFor(step.icon).url()}
                  alt={step.title}
                  class="mb-6 h-12 w-12 object-contain"
                />
              )
            }

            <h3 class="mb-4 text-2xl font-semibold">
              {step.title}
            </h3>

            <p class="leading-7 text-gray-600">
              {step.description}
            </p>

          </div>
        ))
      }
    </div>
  </div>
</section>