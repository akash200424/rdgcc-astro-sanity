---
import { urlFor } from "../../lib/sanity";

const { process } = Astro.props;
---

<section id="process" class="bg-[#F7F7F7] py-32">
  <div class="page-container">

    <!-- Heading -->
    <div class="mx-auto max-w-[1400px] text-center">
      <h2 class="text-[64px] font-bold leading-tight tracking-[-1px] text-[#0A4D8C]">
        {process.heading}
      </h2>

      <p class="mx-auto mt-8 max-w-[1200px] text-[24px] leading-10 text-slate-600">
        {process.description}
      </p>
    </div>

    <!-- Process Cards -->
    <div class="mt-24 grid grid-cols-1 gap-10 md:grid-cols-2 xl:grid-cols-4">
      {
        process.steps?.map((step: any) => (
          <div
            class="flex min-h-[520px] flex-col rounded-[30px] bg-white p-12 shadow-lg transition-all duration-300 hover:-translate-y-3 hover:shadow-2xl"
          >
            {
              step.icon && (
                <img
                  src={urlFor(step.icon).url()}
                  alt={step.title}
                  class="mb-10 h-20 w-20 object-contain"
                />
              )
            }

            <h3 class="mb-8 text-[38px] font-bold leading-tight text-[#0A4D8C]">
              {step.title}
            </h3>

            <p class="text-[22px] leading-10 text-slate-600">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>

  </div>
</section>