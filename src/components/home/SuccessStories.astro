---
import { urlFor } from "../../lib/sanity";

const { successStories } = Astro.props;
---

<section id="success-stories" class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-6">

    <h2 class="text-center text-4xl font-bold text-blue-900">
      {successStories.heading}
    </h2>

    <p class="mx-auto mt-4 max-w-3xl text-center text-gray-600">
      {successStories.description}
    </p>

    <div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-3">

      {
        successStories?.stories?.map((story: any) => (
          <article class="overflow-hidden rounded-2xl bg-white shadow-lg transition duration-300 hover:-translate-y-2 hover:shadow-xl">

            <div class="p-6">

              <p class="text-sm font-semibold text-blue-900">
                {story.industry} | {story.country}
              </p>

              <h3 class="mt-2 text-2xl font-bold text-blue-900">
                {story.companyName}
              </h3>

            </div>

            {
              story.coverImage && (
                <img
                  src={urlFor(story.coverImage).url()}
                  alt={story.companyName}
                  class="h-60 w-full object-cover"
                />
              )
            }

            <div class="p-6">

              <div class="flex items-center gap-4">

                {
                  story.icon && (
                    <img
                      src={urlFor(story.icon).url()}
                      alt={story.projectTitle}
                      class="h-12 w-12 rounded-full object-contain"
                    />
                  )
                }

                <h4 class="text-2xl font-semibold text-blue-900">
                  {story.projectTitle}
                </h4>

              </div>

              <p class="mt-5 leading-8 text-gray-600">
                {story.description}
              </p>

            </div>

          </article>
        ))
      }

    </div>

  </div>
</section>