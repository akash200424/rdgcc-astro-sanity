---
import { urlFor } from "../../lib/sanity";

const { successStories } = Astro.props;
---

<section class="py-20">
  <div class="mx-auto max-w-7xl px-6">
    <h2 class="text-4xl font-bold text-center">
      {successStories.heading}
    </h2>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {
        successStories?.stories?.map((story: any) => (
          <div class="rounded-xl border p-6 shadow-sm">
            {
              story.logo && (
                <img
                  src={urlFor(story.logo).url()}
                  alt={story.companyName}
                  class="h-12 mb-4"
                />
              )
            }

            <h3 class="text-2xl font-semibold">
              {story.companyName}
            </h3>

            <p class="text-sm text-gray-500">
              {story.location}
            </p>

            <p class="mt-4 text-gray-600">
              {story.description}
            </p>

            {
              story.button && (
                <a
                  href={story.button.url}
                  class="mt-6 inline-block rounded bg-blue-600 px-5 py-2 text-white"
                >
                  {story.button.text}
                </a>
              )
            }
          </div>
        ))
      }
    </div>
  </div>
</section>