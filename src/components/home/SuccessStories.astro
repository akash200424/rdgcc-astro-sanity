---
import { urlFor } from "../../lib/sanity";

const { successStories } = Astro.props;
---

<section id="success-stories" class="bg-white py-32">
  <div class="mx-auto max-w-[1800px] px-12">

    <!-- Heading -->
    <div class="mx-auto max-w-[1650px] text-center">

      <h2
        class="text-[72px] font-bold leading-tight tracking-[-1px] text-[#0A4D8C]"
      >
        {successStories.heading}
      </h2>

      <p
        class="mx-auto mt-8 max-w-[1450px] text-[30px] leading-[1.7] text-slate-600"
      >
        {successStories.description}
      </p>

    </div>

    <!-- Cards -->
    <div class="mt-24 grid gap-10 md:grid-cols-2 xl:grid-cols-3">

      {
        successStories?.stories?.map((story: any) => (

          <article
            class="rounded-[32px] border border-slate-200 bg-white shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl"
          >

            <!-- Top -->
            <div class="px-12 pt-12">

              <p
                class="text-[20px] font-semibold uppercase tracking-[2px] text-[#0A4D8C]"
              >
                {story.industry} | {story.country}
              </p>

              <h3
                class="mt-5 text-[44px] font-bold leading-tight text-[#0A4D8C]"
              >
                {story.companyName}
              </h3>

            </div>

            <!-- Image -->
            {
              story.coverImage && (
                <div class="px-12 pt-8">

                  <img
                    src={urlFor(story.coverImage).url()}
                    alt={story.companyName}
                    class="h-[320px] w-full rounded-[24px] object-cover"
                  />

                </div>
              )
            }

            <!-- Bottom -->
            <div class="p-12">

              <div class="flex items-center gap-6">

                {
                  story.icon && (
                    <img
                      src={urlFor(story.icon).url()}
                      alt={story.projectTitle}
                      class="h-[72px] w-[72px] rounded-full object-contain"
                    />
                  )
                }

                <h4
                  class="text-[34px] font-bold leading-tight text-[#0A4D8C]"
                >
                  {story.projectTitle}
                </h4>

              </div>

              <p
                class="mt-8 text-[22px] leading-[1.9] text-slate-600"
              >
                {story.description}
              </p>

            </div>

          </article>

        ))
      }

    </div>

  </div>
</section>