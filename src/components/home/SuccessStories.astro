---
import { urlFor } from "../../lib/sanity";

const { successStories } = Astro.props;
---

<section id="success-stories" class="bg-white py-16">
  <div class="mx-auto max-w-[1250px] px-8">

    <!-- Heading -->
    <div class="mx-auto max-w-[820px] text-center">

      <h2
        class="text-[38px] font-bold leading-tight tracking-[-0.5px] text-[#0A4D8C]"
      >
        {successStories.heading}
      </h2>

      <p
        class="mx-auto mt-4 max-w-[700px] text-[15px] leading-7 text-slate-600"
      >
        {successStories.description}
      </p>

    </div>

    <!-- Cards -->
    <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">

      {
        successStories?.stories?.map((story: any) => (

          <article
            class="rounded-[18px] border border-slate-200 bg-white shadow-md transition-all duration-300 hover:-translate-y-2 hover:shadow-lg"
          >

            <!-- Top -->
            <div class="px-6 pt-6">

              <p
                class="text-[12px] font-semibold uppercase tracking-wide text-[#0A4D8C]"
              >
                {story.industry} | {story.country}
              </p>

              <h3
                class="mt-2 text-[20px] font-bold leading-tight text-[#0A4D8C]"
              >
                {story.companyName}
              </h3>

            </div>

            <!-- Image -->
            {
              story.coverImage && (
                <div class="px-6 pt-5">

                  <img
                    src={urlFor(story.coverImage).url()}
                    alt={story.companyName}
                    class="h-[200px] w-full rounded-[14px] object-cover"
                  />

                </div>
              )
            }

            <!-- Bottom -->
            <div class="p-6">

              <div class="flex items-center gap-3">

                {
                  story.icon && (
                    <img
                      src={urlFor(story.icon).url()}
                      alt={story.projectTitle}
                      class="h-11 w-11 rounded-full object-contain"
                    />
                  )
                }

                <h4
                  class="text-[19px] font-bold leading-tight text-[#0A4D8C]"
                >
                  {story.projectTitle}
                </h4>

              </div>

              <p
                class="mt-4 text-[14px] leading-6 text-slate-600"
              >
                {story.description}
              </p>

            </div>

          </article>

        ))
      }

    </div>

  </div>
</section>
```